# Server
NODE_ENV=development
PORT=3000

# Comma-separated allowlist (never "*")
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Set true when behind Nginx / reverse proxy
TRUST_PROXY=false

# PostgreSQL (required for Prisma migrate / repository persistence)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/civil

# Optional until Auth foundation
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
