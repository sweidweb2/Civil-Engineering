// Civil Engineering API — PostgreSQL schema (Prisma ORM v7)
//
// Generator output: src/generated/prisma (imported from src/database only)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// =============================================================================
// users — User + Profile (auth foundation)
// =============================================================================

enum Role {
  SUPER
  ADMIN
  PROVIDER
  WORKER
  MANAGER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  /// Self-registered PM, provider, or worker waiting for admin approval. Cannot sign in.
  PENDING
}

/// Worker marketplace visibility. Only VERIFIED workers are public.
enum VerificationStatus {
  UNVERIFIED
  REQUESTED
  VERIFIED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 Role           @default(CLIENT)
  status               UserStatus     @default(ACTIVE)
  /// Worker marketplace visibility. isVerified stays true only when this is VERIFIED.
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  isVerified           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  profile              Profile?
  managerProfile       ManagerProfile?
  activityLogs         ActivityLog[]
  deviceTokens         DeviceToken[]
  files                File[]
  provider             Provider?
  projects             Project[]
  steps                Step[]
  reviews              Review[]
  sentNotifications    Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")

  @@index([role, status])
  @@index([status])
  @@index([createdAt])
  @@index([role, verificationStatus])
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "profiles_firstName_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "profiles_lastName_trgm_idx", type: Gin)
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "profiles_displayName_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "profiles_phone_trgm_idx", type: Gin)
  @@map("profiles")
}

/// Optional CV / additional info for project managers (civil engineers).
model ManagerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String?
  bio             String?
  yearsExperience Int?
  specialty       String?
  education       String?
  certifications  String?
  skills          String?
  languages       String?
  city            String?
  country         String?
  website         String?
  linkedinUrl     String?
  cvUrl           String?
  availability    String?
  projectTypes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_profiles")
}

// =============================================================================
// auth — JWT refresh denylist (rotation + logout); no full session table yet
// =============================================================================

/// Denied refresh jti values until natural JWT expiry (survives Redis outages).
model DeniedRefreshToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("denied_refresh_tokens")
}

// =============================================================================
// devices — Expo push tokens (mobile notification bedrock)
// =============================================================================

enum DevicePlatform {
  IOS
  ANDROID
  UNKNOWN
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform @default(UNKNOWN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// =============================================================================
// logging — activity audit + unexpected error inbox (SUPER panel)
// =============================================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  requestId String?
  userId    String?
  code      String?
  message   String
  stack     String?
  path      String?
  method    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// =============================================================================
// files — object metadata (blob in Cloudflare R2)
// =============================================================================

enum FileStatus {
  PENDING
  READY
  DELETED
}

enum FileEntityType {
  PROJECT
  USER
  EXPENSE
  MATERIAL
  WORKER
  LISTING
}

model File {
  id           String         @id @default(cuid())
  key          String         @unique
  bucket       String
  mime         String
  size         Int?
  originalName String
  status       FileStatus     @default(PENDING)
  uploadedById String
  entityType   FileEntityType
  entityId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([status])
  @@map("files")
}

// =============================================================================
// providers — one provider company per owner user
// =============================================================================

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Provider {
  id          String         @id @default(cuid())
  ownerUserId String         @unique
  name        String
  description String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      ProviderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  categories  Category[]
  listings    Listing[]

  @@index([status])
  @@index([city, country])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "providers_name_trgm_idx", type: Gin)
  @@map("providers")
}

// =============================================================================
// categories — platform + provider (two-level tree)
// =============================================================================

enum CategoryScope {
  PLATFORM
  PROVIDER
}

enum CategoryKind {
  MATERIAL
  EQUIPMENT
  SERVICE
  WORKER
}

model Category {
  id         String        @id @default(cuid())
  scope      CategoryScope
  /// Null for platform categories. Named providerId (table is providers, not companies).
  providerId String?
  kind       CategoryKind
  name       String
  slug       String
  parentId   String?
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  provider   Provider?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  parent     Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]    @relation("CategoryTree")
  listings   Listing[]
  stepInputs StepInput[]
  projectStepInputs ProjectStepInput[]

  @@index([scope, kind])
  @@index([providerId])
  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// =============================================================================
// listings — directory records (materials, equipment, services)
// =============================================================================

enum ListingType {
  MATERIAL
  EQUIPMENT
  SERVICE
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum RentalUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

model Listing {
  id                String        @id @default(cuid())
  providerId        String
  type              ListingType
  categoryId        String
  name              String
  description       String?
  brand             String?
  unit              String
  currency          String
  price             Decimal       @db.Decimal(18, 4)
  rentalPrice       Decimal?      @db.Decimal(18, 4)
  rentalUnit        RentalUnit?
  quantityAvailable Decimal?      @db.Decimal(18, 4)
  specs             Json?
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  provider          Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variations        ListingVariation[]
  offers            ListingOffer[]
  images            ListingImage[]

  @@index([providerId])
  @@index([categoryId])
  @@index([type, status])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "listings_name_trgm_idx", type: Gin)
  @@map("listings")
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  storagePath  String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, displayOrder])
  @@index([listingId, isMain])
  @@map("listing_images")
}

model ListingVariation {
  id                String   @id @default(cuid())
  listingId         String
  name              String
  sku               String?
  price             Decimal  @db.Decimal(18, 4)
  unit              String
  quantityAvailable Decimal? @db.Decimal(18, 4)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_variations")
}

model ListingOffer {
  id          String    @id @default(cuid())
  listingId   String
  title       String
  description String?
  price       Decimal   @db.Decimal(18, 4)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([isActive, startsAt, endsAt])
  @@map("listing_offers")
}

// =============================================================================
// projects — Project management for civil engineering
// =============================================================================

enum ProjectStatus {
  DRAFT
  PLANNING
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  OTHER
}

model Project {
  id              String         @id @default(cuid())
  name            String
  description     String?
  code            String?        @unique
  ownerId         String
  address         String?
  city            String?
  country         String?
  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  status          ProjectStatus  @default(DRAFT)
  progress        Int            @default(0)
  budget          Decimal?       @db.Decimal(18, 4)
  currency        String         @default("USD")
  actualCost      Decimal?       @db.Decimal(18, 4)
  type            ProjectType?
  isPublic        Boolean        @default(false)
  tags            Json?
  attachments     Json?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  images          ProjectImage[]
  stepperProjects StepperProject[]

  @@index([ownerId])
  @@index([status])
  @@index([startDate])
  @@index([city, country])
  @@index([createdAt])
  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  storagePath  String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, displayOrder])
  @@index([projectId, isMain])
  @@map("project_images")
}

// =============================================================================
// steps — Per-user project step templates; copied onto projects at create
// =============================================================================

enum StepStatus {
  ACTIVE
  INACTIVE
  /// Hidden from new projects (like inactive) but kept for history / soft-retire.
  ARCHIVED
}

/// User-owned step templates. Active steps for the project owner are assigned on project create.
model Step {
  id        String     @id @default(cuid())
  name      String
  orderNb   Int        @default(0)
  status    StepStatus @default(ACTIVE)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs    StepInput[]

  @@unique([userId, orderNb])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, orderNb])
  @@map("steps")
}

/// Project-owned stepper instance (cloned from a template at create; independent afterward).
model StepperProject {
  id        String   @id @default(cuid())
  projectId String
  name      String
  orderNb   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inputs    ProjectStepInput[]

  @@unique([projectId, orderNb])
  @@index([projectId])
  @@map("stepper_project")
}

/// Project-owned stepper field (cloned or added on the project). Independent of templates.
model ProjectStepInput {
  id               String   @id @default(cuid())
  stepperProjectId String
  inputTypeId      String
  /// Snapshotted at create so catalog renames cannot change rendering of this field.
  inputTypeCode    String
  inputTypeLabel   String
  label            String
  orderNb          Int      @default(0)
  /// Required when inputTypeCode is CATEGORY; scopes the listing picker.
  categoryId       String?
  /// Flexible JSON: scalar (TEXT/NUMBER/YES_NO/DATE) or listing snapshot (CATEGORY).
  value            Json?
  /// True when added on the project (not cloned from a template).
  isProjectOnly    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  stepperProject   StepperProject @relation(fields: [stepperProjectId], references: [id], onDelete: Cascade)
  inputType        InputType      @relation(fields: [inputTypeId], references: [id], onDelete: Restrict)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([stepperProjectId, orderNb])
  @@index([stepperProjectId])
  @@index([inputTypeId])
  @@index([categoryId])
  @@map("project_step_inputs")
}

/// Platform catalog of field kinds for step inputs. SUPER manages; only ACTIVE types are selectable.
model InputType {
  id        String         @id @default(cuid())
  code      String         @unique
  label     String
  status    InputTypeStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  stepInputs StepInput[]
  projectStepInputs ProjectStepInput[]

  @@index([status, sortOrder])
  @@map("input_types")
}

enum InputTypeStatus {
  ACTIVE
  INACTIVE
}

/// Input fields attached to a step template (stepper_inputs). Cloned onto projects at create.
model StepInput {
  id          String   @id @default(cuid())
  stepId      String
  inputTypeId String
  label       String
  orderNb     Int      @default(0)
  /// Required when input type code is CATEGORY; scopes the listing picker on projects.
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  step        Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  inputType   InputType @relation(fields: [inputTypeId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([stepId, orderNb])
  @@index([stepId])
  @@index([inputTypeId])
  @@index([categoryId])
  @@map("stepper_inputs")
}

// =============================================================================
// notifications — User notification system
// =============================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  senderId   String?
  receiverId String
  type       NotificationType @default(INFO)
  title      String
  message    String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  sender     User?            @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  receiver   User             @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, deletedAt])
  @@index([receiverId, isRead, deletedAt])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// reviews — directory ratings (provider, worker, listing)
// =============================================================================

enum ReviewTargetType {
  PROVIDER
  WORKER
  LISTING
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// One rating per author per target. targetId is Provider, worker User, or Listing.
model Review {
  id         String           @id @default(cuid())
  authorId   String
  targetType ReviewTargetType
  targetId   String
  rating     Int
  comment    String
  status     ReviewStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([authorId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([comment(ops: raw("gin_trgm_ops"))], map: "reviews_comment_trgm_idx", type: Gin)
  @@map("reviews")
}

