// Civil Engineering API — PostgreSQL schema (Prisma ORM v7)
//
// Generator output: src/generated/prisma (imported from src/database only)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// users — User + Profile (auth foundation)
// =============================================================================

enum Role {
  SUPER
  ADMIN
  PROVIDER
  WORKER
  MANAGER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(CLIENT)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  activityLogs ActivityLog[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// =============================================================================
// auth — RefreshToken / AuthSession (TBD — refresh is JWT-only for now)
// =============================================================================

// =============================================================================
// logging — activity audit + unexpected error inbox (SUPER panel)
// =============================================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  requestId String?
  userId    String?
  code      String?
  message   String
  stack     String?
  path      String?
  method    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

