// Civil Engineering API — PostgreSQL schema (Prisma ORM v7)
//
// Generator output: src/generated/prisma (imported from src/database only)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// users — User + Profile (auth foundation)
// =============================================================================

enum Role {
  SUPER
  ADMIN
  PROVIDER
  WORKER
  MANAGER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(CLIENT)
  status       UserStatus    @default(ACTIVE)
  /// Admin verification page — marketplace visibility for workers (and reuse for other roles).
  isVerified   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  activityLogs ActivityLog[]
  deviceTokens DeviceToken[]
  files        File[]
  provider     Provider?

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// =============================================================================
// auth — RefreshToken / AuthSession (TBD — refresh is JWT-only for now)
// =============================================================================

// =============================================================================
// devices — Expo push tokens (mobile notification bedrock)
// =============================================================================

enum DevicePlatform {
  IOS
  ANDROID
  UNKNOWN
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform @default(UNKNOWN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// =============================================================================
// logging — activity audit + unexpected error inbox (SUPER panel)
// =============================================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  requestId String?
  userId    String?
  code      String?
  message   String
  stack     String?
  path      String?
  method    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// =============================================================================
// files — object metadata (blob in Cloudflare R2)
// =============================================================================

enum FileStatus {
  PENDING
  READY
  DELETED
}

enum FileEntityType {
  PROJECT
  USER
  EXPENSE
  MATERIAL
  WORKER
  LISTING
}

model File {
  id           String         @id @default(cuid())
  key          String         @unique
  bucket       String
  mime         String
  size         Int?
  originalName String
  status       FileStatus     @default(PENDING)
  uploadedById String
  entityType   FileEntityType
  entityId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([status])
  @@map("files")
}

// =============================================================================
// providers — one provider company per owner user
// =============================================================================

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Provider {
  id          String         @id @default(cuid())
  ownerUserId String         @unique
  name        String
  description String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      ProviderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  categories  Category[]
  listings    Listing[]

  @@index([status])
  @@index([city, country])
  @@map("providers")
}

// =============================================================================
// categories — platform + provider (two-level tree)
// =============================================================================

enum CategoryScope {
  PLATFORM
  PROVIDER
}

enum CategoryKind {
  MATERIAL
  EQUIPMENT
  SERVICE
  WORKER
}

model Category {
  id         String        @id @default(cuid())
  scope      CategoryScope
  /// Null for platform categories. Named providerId (table is providers, not companies).
  providerId String?
  kind       CategoryKind
  name       String
  slug       String
  parentId   String?
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  provider   Provider?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  parent     Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]    @relation("CategoryTree")
  listings   Listing[]

  @@index([scope, kind])
  @@index([providerId])
  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// =============================================================================
// listings — directory records (materials, equipment, services)
// =============================================================================

enum ListingType {
  MATERIAL
  EQUIPMENT
  SERVICE
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum RentalUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

model Listing {
  id                String        @id @default(cuid())
  providerId        String
  type              ListingType
  categoryId        String
  name              String
  description       String?
  brand             String?
  unit              String
  currency          String
  price             Decimal       @db.Decimal(18, 4)
  rentalPrice       Decimal?      @db.Decimal(18, 4)
  rentalUnit        RentalUnit?
  quantityAvailable Decimal?      @db.Decimal(18, 4)
  specs             Json?
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  provider          Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variations        ListingVariation[]
  offers            ListingOffer[]

  @@index([providerId])
  @@index([categoryId])
  @@index([type, status])
  @@map("listings")
}

model ListingVariation {
  id                String   @id @default(cuid())
  listingId         String
  name              String
  sku               String?
  price             Decimal  @db.Decimal(18, 4)
  unit              String
  quantityAvailable Decimal? @db.Decimal(18, 4)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_variations")
}

model ListingOffer {
  id          String    @id @default(cuid())
  listingId   String
  title       String
  description String?
  price       Decimal   @db.Decimal(18, 4)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([isActive, startsAt, endsAt])
  @@map("listing_offers")
}

