# =============================================================================
# Vercel project env cheat-sheet (Services: backend + civil-web)
# =============================================================================
# One Vercel project → put these in the import / Project Settings env list.
# Scope below = which app consumes the var (not separate Vercel forms).
# Never commit real secrets. Never prefix secrets with VITE_.
#
# Environments on Vercel:
#   Production  → main
#   Preview     → dev / PRs
# =============================================================================

# -----------------------------------------------------------------------------
# SCOPE: civil-web  (Vite — build-time only; safe for browser if VITE_*)
# Production + Preview
# -----------------------------------------------------------------------------
VITE_APP_ENV=production
VITE_APP_NAME=Civil Engineering
# Same-origin via vercel.json rewrite /api → backend
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# SCOPE: backend  (Express — runtime secrets)
# Production: NODE_ENV=production | Preview: NODE_ENV=staging (or production)
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=civil-api
TRUST_PROXY=true
LOG_LEVEL=info

# Postgres (Supabase Session pooler — IPv4)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase (backend only — never put SERVICE_ROLE on civil-web / VITE_*)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT (min 32 chars each; use different secrets for Production vs Preview)
JWT_ACCESS_SECRET=replace_with_long_random_access_secret_32plus
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret_32plus
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — your Vercel web origin(s), comma-separated, never "*"
# Production example:
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
# Preview: add the preview URL(s) for that environment in Vercel UI

# Rate limits / body
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Cloudflare R2
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=civil-bucket
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key
STORAGE_SECRET_KEY=your_r2_secret_key
STORAGE_UPLOAD_URL_TTL_SEC=600
STORAGE_DOWNLOAD_URL_TTL_SEC=600
STORAGE_MAX_BYTES=25000000

# Optional
# EXPO_ACCESS_TOKEN=
# STORAGE_PUBLIC_BASE_URL=
# CLOUDFLARE_API_TOKEN=

# -----------------------------------------------------------------------------
# Not needed on Vercel
# -----------------------------------------------------------------------------
# PORT=3000
