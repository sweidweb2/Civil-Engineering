// Civil Engineering API — PostgreSQL schema (Prisma ORM v7)
//
// Generator output: src/generated/prisma (imported from src/database only)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// =============================================================================
// users — User + Profile (auth foundation)
// =============================================================================

enum Role {
  SUPER
  ADMIN
  PROVIDER
  WORKER
  MANAGER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  /// Self-registered PM, provider, or worker waiting for admin approval. Cannot sign in.
  PENDING
}

/// Worker marketplace visibility. Only VERIFIED workers are public.
enum VerificationStatus {
  UNVERIFIED
  REQUESTED
  VERIFIED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 Role           @default(CLIENT)
  status               UserStatus     @default(ACTIVE)
  /// Worker marketplace visibility. isVerified stays true only when this is VERIFIED.
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  isVerified           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  profile              Profile?
  managerProfile       ManagerProfile?
  activityLogs         ActivityLog[]
  deviceTokens         DeviceToken[]
  files                File[]
  provider             Provider?
  projects             Project[]
  reviews              Review[]
  sentNotifications    Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")

  @@index([role, status])
  @@index([status])
  @@index([createdAt])
  @@index([role, verificationStatus])
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "profiles_firstName_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "profiles_lastName_trgm_idx", type: Gin)
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "profiles_displayName_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "profiles_phone_trgm_idx", type: Gin)
  @@map("profiles")
}

/// Optional CV / additional info for project managers (civil engineers).
model ManagerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String?
  bio             String?
  yearsExperience Int?
  specialty       String?
  education       String?
  certifications  String?
  skills          String?
  languages       String?
  city            String?
  country         String?
  website         String?
  linkedinUrl     String?
  cvUrl           String?
  availability    String?
  projectTypes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_profiles")
}

/// Self-serve registration fingerprint (device id + IP). Caps abuse per device.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  deviceId  String
  ipAddress String?
  userAgent String?
  userId    String?
  role      Role
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([ipAddress])
  @@map("registration_attempts")
}

// =============================================================================
// auth — JWT refresh denylist (rotation + logout); no full session table yet
// =============================================================================

/// Denied refresh jti values until natural JWT expiry (logout / rotation denylist).
model DeniedRefreshToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("denied_refresh_tokens")
}

// =============================================================================
// devices — Expo push tokens (mobile notification bedrock)
// =============================================================================

enum DevicePlatform {
  IOS
  ANDROID
  UNKNOWN
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform @default(UNKNOWN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// =============================================================================
// logging — activity audit + unexpected error inbox (SUPER panel)
// =============================================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  requestId String?
  userId    String?
  code      String?
  message   String
  stack     String?
  path      String?
  method    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// =============================================================================
// files — object metadata (blob in Cloudflare R2)
// =============================================================================

enum FileStatus {
  PENDING
  READY
  DELETED
}

enum FileEntityType {
  PROJECT
  USER
  EXPENSE
  MATERIAL
  WORKER
  LISTING
}

model File {
  id           String         @id @default(cuid())
  key          String         @unique
  bucket       String
  mime         String
  size         Int?
  originalName String
  status       FileStatus     @default(PENDING)
  uploadedById String
  entityType   FileEntityType
  entityId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([status])
  @@map("files")
}

// =============================================================================
// providers — one provider company per owner user
// =============================================================================

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Provider {
  id          String         @id @default(cuid())
  /// Optional until an admin assigns a PROVIDER user.
  ownerUserId String?        @unique
  name        String
  description String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      ProviderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User?          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  categories  Category[]
  listings    Listing[]

  @@index([status])
  @@index([city, country])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "providers_name_trgm_idx", type: Gin)
  @@map("providers")
}

// =============================================================================
// categories — platform + provider (two-level tree)
// =============================================================================

enum CategoryScope {
  PLATFORM
  PROVIDER
}

enum CategoryKind {
  MATERIAL
  EQUIPMENT
  SERVICE
  WORKER
}

model Category {
  id         String        @id @default(cuid())
  scope      CategoryScope
  /// Null for platform categories. Named providerId (table is providers, not companies).
  providerId String?
  kind       CategoryKind
  name       String
  /// Optional Arabic display name; clients fall back to `name` when null/empty.
  nameAr     String?
  slug       String
  parentId   String?
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  provider   Provider?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  parent     Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]    @relation("CategoryTree")
  listings   Listing[]

  @@index([scope, kind])
  @@index([providerId])
  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// =============================================================================
// listings — directory records (materials, equipment, services)
// =============================================================================

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum RentalUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

model Listing {
  id                String        @id @default(cuid())
  /// Optional until assigned; providers are auto-scoped on create.
  providerId        String?
  categoryId        String?
  name              String
  description       String?
  brand             String?
  unit              String?
  currency          String?
  /// Fixed informational price when the listing is not a range.
  price             Decimal?      @db.Decimal(18, 4)
  /// Range lower bound when price is unset.
  priceMin          Decimal?      @db.Decimal(18, 4)
  /// Range upper bound when price is unset.
  priceMax          Decimal?      @db.Decimal(18, 4)
  rentalPrice       Decimal?      @db.Decimal(18, 4)
  rentalUnit        RentalUnit?
  quantityAvailable Decimal?      @db.Decimal(18, 4)
  specs             Json?
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  provider          Provider?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ListingImage[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([providerId, status, updatedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "listings_name_trgm_idx", type: Gin)
  @@index([brand(ops: raw("gin_trgm_ops"))], map: "listings_brand_trgm_idx", type: Gin)
  @@map("listings")
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  storagePath  String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, displayOrder])
  @@index([listingId, isMain])
  /// Partial unique (one main per listing) — see migration `gallery_one_main_partial_unique`.
  @@map("listing_images")
}

// =============================================================================
// projects — Project management for civil engineering
// =============================================================================

enum ProjectStatus {
  DRAFT
  PLANNING
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  OTHER
}

model Project {
  id              String         @id @default(cuid())
  name            String
  description     String?
  code            String?        @unique
  ownerId         String
  address         String?
  city            String?
  country         String?
  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  status          ProjectStatus  @default(DRAFT)
  progress        Int            @default(0)
  budget          Decimal?       @db.Decimal(18, 4)
  currency        String         @default("USD")
  actualCost      Decimal?       @db.Decimal(18, 4)
  type            ProjectType?
  isPublic        Boolean        @default(false)
  tags            Json?
  attachments     Json?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?
  owner              User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  images             ProjectImage[]
  geotechnicalStudy  GeotechnicalStudy?
  design             ProjectDesign?
  licensing          ProjectLicensing?
  materialProcurement MaterialProcurement?
  maintenance        ProjectMaintenance?

  @@index([ownerId])
  @@index([status])
  @@index([startDate])
  @@index([city, country])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([ownerId, archivedAt, createdAt])
  @@index([archivedAt, createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "projects_name_trgm_idx", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "projects_code_trgm_idx", type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], map: "projects_city_trgm_idx", type: Gin)
  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  storagePath  String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, displayOrder])
  @@index([projectId, isMain])
  /// Partial unique (one main per project) — see migration `gallery_one_main_partial_unique`.
  @@map("project_images")
}

/// Shared lifecycle for the five fixed project stage records (one row per project each).
enum ProjectStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model GeotechnicalStudy {
  id                       String              @id @default(cuid())
  projectId                String              @unique
  soilType                 String?
  soilBearingCapacity      Decimal?            @db.Decimal(18, 4)
  groundwaterLevel         Decimal?            @db.Decimal(18, 4)
  foundationRecommendation String?
  reportFilePath           String?
  consultantName           String?
  status                   ProjectStageStatus  @default(NOT_STARTED)
  startDate                DateTime?
  completionDate           DateTime?
  notes                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  project                  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("geotechnical_studies")
}

model ProjectDesign {
  id                      String              @id @default(cuid())
  projectId               String              @unique
  architecturalDesignPath String?
  structuralDesignPath    String?
  mepDesignPath           String?
  architectName           String?
  structuralEngineerName  String?
  mepEngineerName         String?
  status                  ProjectStageStatus  @default(NOT_STARTED)
  startDate               DateTime?
  completionDate          DateTime?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  project                 Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_designs")
}

model ProjectLicensing {
  id               String              @id @default(cuid())
  projectId        String              @unique
  permitNumber     String?
  issuingAuthority String?
  applicationDate  DateTime?
  approvalDate     DateTime?
  permitFilePath   String?
  status           ProjectStageStatus  @default(NOT_STARTED)
  expiryDate       DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_licensings")
}

model MaterialProcurement {
  id                  String              @id @default(cuid())
  projectId           String              @unique
  supplierName        String?
  materialDescription String?
  quantity            Decimal?            @db.Decimal(18, 4)
  unit                String?
  totalCost           Decimal?            @db.Decimal(18, 4)
  currency            String?
  originCountry       String?
  orderDate           DateTime?
  expectedArrivalDate DateTime?
  actualArrivalDate   DateTime?
  invoiceFilePath     String?
  status              ProjectStageStatus  @default(NOT_STARTED)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("material_procurements")
}

model ProjectMaintenance {
  id                String              @id @default(cuid())
  projectId         String              @unique
  maintenanceType   String?
  description       String?
  responsiblePerson String?
  scheduledDate     DateTime?
  completionDate    DateTime?
  cost              Decimal?            @db.Decimal(18, 4)
  status            ProjectStageStatus  @default(NOT_STARTED)
  reportFilePath    String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_maintenances")
}

// =============================================================================
// notifications — User notification system
// =============================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  senderId   String?
  receiverId String
  type       NotificationType @default(INFO)
  title      String
  message    String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  sender     User?            @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  receiver   User             @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, deletedAt])
  @@index([receiverId, isRead, deletedAt])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// reviews — directory ratings (provider, worker, listing)
// =============================================================================

enum ReviewTargetType {
  PROVIDER
  WORKER
  LISTING
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// One rating per author per target. targetId is Provider, worker User, or Listing.
model Review {
  id         String           @id @default(cuid())
  authorId   String
  targetType ReviewTargetType
  targetId   String
  rating     Int
  comment    String
  status     ReviewStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([authorId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([comment(ops: raw("gin_trgm_ops"))], map: "reviews_comment_trgm_idx", type: Gin)
  @@map("reviews")
}

