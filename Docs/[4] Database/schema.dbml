// Civil Engineering — PostgreSQL schema (DBML)
// Mirrors backend/prisma/schema.prisma (source of truth for migrations).
// Domains still TBD: auth sessions, projects, workers, materials, expenses.

Enum Role {
  SUPER
  ADMIN
  PROVIDER
  WORKER
  MANAGER
  CLIENT
}

Enum UserStatus {
  ACTIVE
  INACTIVE
}

Table users {
  id            String     [pk, default: `cuid()`]
  email         String     [unique, not null]
  passwordHash  String     [not null, note: 'bcrypt/argon hash — never plaintext']
  role          Role       [not null, default: 'CLIENT']
  status        UserStatus [not null, default: 'ACTIVE']
  createdAt     DateTime   [not null, default: `now()`]
  updatedAt     DateTime   [not null, note: 'auto @updatedAt']

  Note: 'users domain — account identity + credentials'
}

Table profiles {
  id           String   [pk, default: `cuid()`]
  userId       String   [unique, not null]
  firstName    String
  lastName     String
  displayName  String
  phone        String
  avatarUrl    String
  createdAt    DateTime [not null, default: `now()`]
  updatedAt    DateTime [not null, note: 'auto @updatedAt']

  Note: '1:1 profile for User'
}

Table activity_logs {
  id         String   [pk, default: `cuid()`]
  userId     String
  action     String   [not null]
  entity     String
  entityId   String
  meta       Json
  ip         String
  requestId  String
  createdAt  DateTime [not null, default: `now()`]

  Note: 'audit trail for SUPER panel / ops'
}

Table error_logs {
  id         String   [pk, default: `cuid()`]
  requestId  String
  userId     String
  code       String
  message    String   [not null]
  stack      String
  path       String
  method     String
  status     Int
  createdAt  DateTime [not null, default: `now()`]

  Note: 'unexpected error inbox — no FK to users (may be anonymous)'
}

Ref: profiles.userId > users.id [delete: cascade]

Ref: activity_logs.userId > users.id [delete: set null]

Indexes users {
  email [unique]
}

Indexes profiles {
  userId [unique]
}

Indexes activity_logs {
  createdAt
  (userId, createdAt)
}

Indexes error_logs {
  createdAt
}

Enum FileStatus {
  PENDING
  READY
  DELETED
}

Enum FileEntityType {
  PROJECT
  USER
  EXPENSE
  MATERIAL
  WORKER
}

Table files {
  id            String         [pk, default: `cuid()`]
  key           String         [unique, not null, note: 'full R2 object key — store as-is']
  bucket        String         [not null]
  mime          String         [not null]
  size          Int
  originalName  String         [not null]
  status        FileStatus     [not null, default: 'PENDING']
  uploadedById  String         [not null]
  entityType    FileEntityType [not null]
  entityId      String         [not null]
  createdAt     DateTime       [not null, default: `now()`]
  updatedAt     DateTime       [not null, note: 'auto @updatedAt']

  Note: 'files domain — metadata only; blob in Cloudflare R2 civil-bucket'
}

Ref: files.uploadedById > users.id [delete: cascade]

Indexes files {
  key [unique]
  (entityType, entityId)
  uploadedById
  status
}
