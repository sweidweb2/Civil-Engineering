# Development — Expo / EXPO_PUBLIC_* are embedded in the client bundle
# Copy to `.env` for local. Also maintain local `.env.staging` / `.env.production`
# (gitignored — same pattern as civil-web). Prefer EAS secrets for remote builds.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Civil Engineering
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
