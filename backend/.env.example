# Backend env template — copy to `.env` for local development.
# Do not put real production secrets here.
#
# Local flow:
#   1) docker compose up -d          # Postgres only
#   2) cp .env.example .env          # if needed
#   3) npm run dev
#
# DATABASE_URL host:
#   - npm on your machine  → 127.0.0.1 / localhost
#   - API inside Docker    → postgres (Compose service name; set by Compose override)

NODE_ENV=development
PORT=3000
APP_NAME=civil-api

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/civil

# Redis — skipped until wired
# REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowlist (never "*")
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

TRUST_PROXY=false

LOG_LEVEL=debug

# JSON body size for express.json (e.g. 100kb, 1mb)
JSON_BODY_LIMIT=100kb

# General API rate limit (skipped when NODE_ENV=test)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Stricter limit on /api/v1/auth/*
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
