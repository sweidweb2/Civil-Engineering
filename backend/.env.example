# Backend env template — copy to `.env` for local development.
# Do not put real production secrets here.
#
# Local flow:
#   1) Set DATABASE_URL to your Supabase Postgres connection string
#   2) cp .env.example .env          # if needed
#   3) npx prisma migrate deploy
#   4) npm run dev
#
# DATABASE_URL:
#   - Supabase Dashboard → Connect → Session pooler (port 5432) on IPv4 networks
#   - URL-encode special characters in the password (@ # + etc.)

NODE_ENV=development
PORT=3000
APP_NAME=civil-api

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase API keys (backend only — never put service role on web/mobile)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Min 32 characters each (required in staging/production)
JWT_ACCESS_SECRET=dev_access_secret_change_me_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowlist (never "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Behind a reverse proxy / Vercel set true (default true when NODE_ENV is staging|production if unset)
TRUST_PROXY=false
# On Vercel: set NODE_ENV=production, CORS_ORIGINS to your Vercel web origin(s), TRUST_PROXY=true

LOG_LEVEL=debug
# Pino levels: fatal | error | warn | info | debug | trace | silent (default info if unset)

# JSON body size for express.json (e.g. 100kb, 1mb)
JSON_BODY_LIMIT=100kb

# General API rate limit (in-process memory store; skipped when NODE_ENV=test)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Stricter limit on /api/v1/auth/*
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Optional — Expo authenticated push (https://docs.expo.dev/push-notifications/sending-notifications/)
# EXPO_ACCESS_TOKEN=

# Object storage — Cloudflare R2 (S3-compatible). Decision: Docs/[3] Decisions/[10] Storage (Cloudflare R2).md
# Copy real values from Docs/[1] Main App/[5] Credentials/Storage - Cloudflare.md into local .env (never commit).
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_BUCKET=civil-bucket
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional — unused for private docs (presigned GET only)
# STORAGE_PUBLIC_BASE_URL=
STORAGE_UPLOAD_URL_TTL_SEC=600
STORAGE_DOWNLOAD_URL_TTL_SEC=600
STORAGE_MAX_BYTES=25000000

# Optional — Cloudflare account API (not used by S3 client uploads)
# CLOUDFLARE_API_TOKEN=
