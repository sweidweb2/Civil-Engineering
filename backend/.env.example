# Server
NODE_ENV=development
PORT=3000

# Comma-separated allowlist (never "*")
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Set true when behind Nginx / reverse proxy
TRUST_PROXY=false

# Optional until Database / Auth foundations
# DATABASE_URL=postgresql://user:pass@localhost:5432/civil
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
